# slimechan3 環境変数のサンプル。実際の値は .env.local に記載する（コミットしない）。

# 公開スプレッドシート(xlsx)の取得 URL。
# サーバー専用。NEXT_PUBLIC_ を付けないこと（クライアントへ露出させない）。
# 実際の URL はここにもリポジトリにも記載しない。運用者が .env.local に設定する。
SCHEDULE_XLSX_URL=

# 同 PC で動作する NodeCG の URL。
NODECG_URL=http://localhost:9090

# 参照する NodeCG bundle 名。
NODECG_BUNDLE=rtainjapan-layouts

# NodeCG のログインセキュリティが有効な場合のみ設定（既定の localhost 運用では不要）。
# NODECG_TOKEN=

# xlsx の再取得間隔（ミリ秒）。既定 60000。
XLSX_POLL_MS=60000
