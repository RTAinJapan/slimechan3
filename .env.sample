# slimechan3 環境変数のサンプル。
# このファイルをコピーして .env を作成し、値を設定する（.env はコミットしない）。
#   cp .env.sample .env
# docker compose は .env を読み込んでコンテナへ渡す。

# 公開スプレッドシート(xlsx)の取得 URL。
# サーバー専用。NEXT_PUBLIC_ を付けないこと（クライアントへ露出させない）。
# 実際の URL はここにもリポジトリにも記載しない。
SCHEDULE_XLSX_URL=

# 同 PC で動作する NodeCG の URL。
# Docker コンテナから同じ PC（ホスト）の NodeCG に接続する場合は
# localhost ではなく host.docker.internal を使う。
# 非 Docker のローカル開発では http://localhost:9090 を指定する。
NODECG_URL=http://host.docker.internal:9090

# 参照する NodeCG bundle 名。
NODECG_BUNDLE=rtainjapan-layouts

# NodeCG のログインセキュリティが有効な場合のみ設定（既定の localhost 運用では不要）。
# NODECG_TOKEN=

# xlsx の再取得間隔（ミリ秒）。既定 60000。
XLSX_POLL_MS=60000

# アプリの待ち受けポート（コンテナ内）。compose のポート公開と合わせる。
PORT=3000
