# slimechan3 環境変数のサンプル。
# このファイルをコピーして .env を作成し、値を設定する（.env はコミットしない）。
#   cp .env.sample .env
# docker compose は .env を読み込んでコンテナへ渡す。

# 公開スプレッドシート(xlsx)の取得 URL。
# サーバー専用。NEXT_PUBLIC_ を付けないこと（クライアントへ露出させない）。
# 実際の URL はここにもリポジトリにも記載しない。
SCHEDULE_XLSX_URL=

# 同 PC で動作する NodeCG の URL。
# Docker コンテナから同じ PC（ホスト）の NodeCG に接続する場合は
# localhost ではなく host.docker.internal を使う。
# 非 Docker のローカル開発では http://localhost:9090 を指定する。
NODECG_URL=http://host.docker.internal:9090

# 参照する NodeCG bundle 名。
NODECG_BUNDLE=rtainjapan-layouts

# ヘッダの「スプレッドシートを開く」ボタンで別タブに開く URL（任意）。
# 未設定でも EDIT_SPREADSHEET_ID があればその編集 URL を自動で使う。
# SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/＜ID＞/edit

# NodeCG のログインセキュリティが有効な場合のみ設定（既定の localhost 運用では不要）。
# NODECG_TOKEN=

# xlsx の再取得間隔（ミリ秒）。既定 60000。
XLSX_POLL_MS=60000

# 投票項目の進捗を取得する Tracker のベース URL。
TRACKER_API_BASE=https://tracker.rtain.jp

# bid 進捗のサーバー側キャッシュ時間（ミリ秒）。既定 7000。
BID_CACHE_MS=7000

# 投票〆トグルのローカル即時表示用の永続ファイル（外部公開用ではない）。
# Docker では volume(/app/data) を使う。
VOTE_OVERRIDE_FILE=/app/data/vote-overrides.json

# --- 投票〆のスプレッドシート書き戻し（任意） ---
# 配信席 Chrome のログイン済み Google アカウント（編集権限あり）を使い、
# ブラウザの OAuth(Google Identity Services) で「投票」シートの「投票〆た」セル
# だけを更新する。設定しなければ書き戻しは無効（ローカル表示のみ）。
#
# 【Google Cloud で OAuth クライアントを作成する手順】
#  - アプリケーションの種類: 「ウェブ アプリケーション」
#  - 承認済みの JavaScript 生成元: アプリを実際に開く URL を登録する
#       例) http://localhost:3000
#       別ポート/別URLでも開くならそれも追加する
#  - 承認済みのリダイレクト URI: 【不要・空のままでよい】
#       GIS のトークンモデルはリダイレクトを使わず JavaScript 生成元のみ参照する
#  - client secret は使わない（GIS トークンフローでは不要）
#  - 作成後に表示される「クライアント ID」を下の GOOGLE_OAUTH_CLIENT_ID に設定する
#  - 設定の反映に 5 分〜数時間かかることがある
#
# 【注意】localhost 以外の JavaScript 生成元は http 不可（https 必須）。
#  http://192.168.x.x:3000 のような LAN の IP では GIS に弾かれるため、
#  書き戻しを行う配信席ではアプリを http://localhost:3000 で開くこと
#  （Docker でもホストの 3000:3000 マッピングなら localhost でアクセス可）。
GOOGLE_OAUTH_CLIENT_ID=
# 編集可能なスプレッドシートの ID（公開 xlsx の URL とは別物。
# 編集用シートの URL /spreadsheets/d/＜ここがID＞/edit から取得）。
EDIT_SPREADSHEET_ID=
# 既定値で問題なければ未設定でよい。
# VOTING_SHEET_NAME=投票
# VOTING_LINK_HEADER=Trackerへのリンク
# VOTING_RUNPK_HEADER=runPk
# VOTING_CLOSED_HEADER=投票〆た

# アプリの待ち受けポート（コンテナ内）。compose のポート公開と合わせる。
PORT=3000
